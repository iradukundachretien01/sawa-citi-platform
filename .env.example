# ---------------------------------------------------------------------------
# Copy this file to .env (server) and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Database
MONGO_URI=

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payments (mock | mtn_momo | airtel | card)
PAYMENT_PROVIDER=mock

MOMO_BASE_URL=
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_USER_ID=
MOMO_CREDENTIAL_TOKEN=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=RWF
MOMO_CALLBACK_URL=
MOMO_CALLBACK_HOST=

# Demo data
# Keep true for local development; production startup requires this to be false.
SEED_DEMO=true
